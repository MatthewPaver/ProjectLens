# Cited precedent RAG — local sidecar only. Never commit real keys.
GEMINI_API_KEY=
# Optional alias some Google SDKs still read:
# GOOGLE_API_KEY=

# LangSmith traces for retrieve → summarise runs
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=projectlens-precedent-rag
# LANGSMITH_WORKSPACE_ID=

# Sidecar bind
PRECEDENT_RAG_HOST=127.0.0.1
PRECEDENT_RAG_PORT=8787

# Model overrides (optional)
# GEMINI_EMBED_MODEL=models/gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-2.5-flash
